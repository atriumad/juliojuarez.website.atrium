# Contact form email (Resend). All three are required in production.
# Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Where inquiries are delivered (address still to be defined with the client).
INQUIRY_TO_EMAIL=
# Verified sender on the Resend domain, e.g. "Julio Juarez <inquiries@yourdomain.com>".
INQUIRY_FROM_EMAIL=

# Canonical origin for metadata, sitemap and Open Graph. Optional: falls back to
# Vercel's production URL, then https://juliojuarez.vercel.app in production
# builds, then localhost in dev. Set it when the client's own domain goes live.
NEXT_PUBLIC_SITE_URL=

# Analytics (all optional; each feature stays off until its value is set).
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Enables GA4 traffic + event tracking.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification token (the content="…" value).
NEXT_PUBLIC_GSC_VERIFICATION=
